// StyleNow — Prisma schema (booking core).
//
// The SQL migrations in db/migrations/ are the source of truth: they carry
// PostGIS geography columns, pgvector embeddings, GiST EXCLUDE constraints and
// RLS policies that Prisma's DSL cannot express. This schema is generated with
// `prisma db pull` and hand-annotated so the application gets types; the
// unsupported columns stay `Unsupported(...)` and are read through raw SQL.
//
// Rule of thumb: reads that need geometry or ranges go through raw queries in
// infrastructure/sql/; everything else goes through the client.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "multiSchema"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, postgis, pg_trgm, vector, citext, btree_gist]
}

enum BookingStatus {
  hold
  pending_payment
  confirmed
  checked_in
  in_progress
  completed
  cancelled_by_customer
  cancelled_by_shop
  no_show
  expired

  @@map("booking_status")
}

enum ShopStatus {
  draft
  pending_review
  changes_requested
  approved
  suspended
  archived

  @@map("shop_status")
}

model AppUser {
  id            String    @id @default(uuid()) @db.Uuid
  email         String?   @unique @db.Citext
  phoneE164     String?   @unique @map("phone_e164")
  displayName   String    @map("display_name")
  locale        String    @default("de-DE")
  timezone      String    @default("Europe/Berlin")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  bookings      Booking[]
  reviews       Review[]
  ownedShops    Shop[]    @relation("ShopOwner")

  @@map("app_user")
}

model Shop {
  id                 String     @id @default(uuid()) @db.Uuid
  chainId            String?    @map("chain_id") @db.Uuid
  ownerUserId        String     @map("owner_user_id") @db.Uuid
  slug               String     @unique
  name               String
  status             ShopStatus @default(draft)
  isMobile           Boolean    @default(false) @map("is_mobile")
  description        String?
  brand              Json       @default("{}")
  city               String?
  countryCode        String     @default("DE") @map("country_code") @db.Char(2)
  geo                Unsupported("geography(Point, 4326)")?
  serviceRadiusM     Int?       @map("service_radius_m")
  timezone           String     @default("Europe/Berlin")
  currency           String     @default("EUR") @db.Char(3)
  bookingLeadMin     Int        @default(60) @map("booking_lead_min")
  bookingHorizonDays Int        @default(90) @map("booking_horizon_days")
  slotGranularityMin Int        @default(15) @map("slot_granularity_min")
  bufferBeforeMin    Int        @default(0) @map("buffer_before_min")
  bufferAfterMin     Int        @default(10) @map("buffer_after_min")
  depositPercent     Decimal    @default(0) @map("deposit_percent") @db.Decimal(5, 2)
  commissionBps      Int        @default(1200) @map("commission_bps")
  stripeAccountId    String?    @map("stripe_account_id")
  ratingAvg          Decimal    @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount        Int        @default(0) @map("rating_count")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz

  owner              AppUser    @relation("ShopOwner", fields: [ownerUserId], references: [id])
  services           Service[]
  staff              Staff[]
  bookings           Booking[]

  @@index([status, city])
  @@map("shop")
}

model Service {
  id               String    @id @default(uuid()) @db.Uuid
  shopId           String    @map("shop_id") @db.Uuid
  name             String
  taxonomyKey      String?   @map("taxonomy_key")
  durationMin      Int       @map("duration_min")
  processingGapMin Int       @default(0) @map("processing_gap_min")
  finishMin        Int       @default(0) @map("finish_min")
  basePriceCents   Int       @map("base_price_cents")
  vatRateBps       Int       @default(1900) @map("vat_rate_bps")
  onlineBookable   Boolean   @default(true) @map("online_bookable")
  mobileAvailable  Boolean   @default(false) @map("mobile_available")
  dynamicPricing   Boolean   @default(false) @map("dynamic_pricing")
  active           Boolean   @default(true)

  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items            BookingItem[]

  @@index([shopId, active])
  @@map("service")
}

model Staff {
  id              String   @id @default(uuid()) @db.Uuid
  shopId          String   @map("shop_id") @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  displayName     String   @map("display_name")
  title           String?
  tier            String   @default("standard")
  acceptsBookings Boolean  @default(true) @map("accepts_bookings")
  isMobile        Boolean  @default(false) @map("is_mobile")
  ratingAvg       Decimal  @default(0) @map("rating_avg") @db.Decimal(3, 2)

  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items           BookingItem[]

  @@map("staff")
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  reference       String        @unique
  shopId          String        @map("shop_id") @db.Uuid
  customerId      String?       @map("customer_id") @db.Uuid
  status          BookingStatus @default(hold)
  // tstzrange has no Prisma primitive; read/written via raw SQL helpers.
  period          Unsupported("tstzrange")
  occupancy       Unsupported("tstzrange")
  isMobile        Boolean       @default(false) @map("is_mobile")
  subtotalCents   Int           @default(0) @map("subtotal_cents")
  travelFeeCents  Int           @default(0) @map("travel_fee_cents")
  discountCents   Int           @default(0) @map("discount_cents")
  vatCents        Int           @default(0) @map("vat_cents")
  totalCents      Int           @default(0) @map("total_cents")
  currency        String        @default("EUR") @db.Char(3)
  holdExpiresAt   DateTime?     @map("hold_expires_at") @db.Timestamptz
  confirmedAt     DateTime?     @map("confirmed_at") @db.Timestamptz
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  shop            Shop          @relation(fields: [shopId], references: [id])
  customer        AppUser?      @relation(fields: [customerId], references: [id])
  items           BookingItem[]
  review          Review?

  @@index([customerId])
  @@index([status])
  @@map("booking")
}

model BookingItem {
  id                  String  @id @default(uuid()) @db.Uuid
  bookingId           String  @map("booking_id") @db.Uuid
  serviceId           String  @map("service_id") @db.Uuid
  staffId             String? @map("staff_id") @db.Uuid
  serviceNameSnapshot String  @map("service_name_snapshot")
  durationMin         Int     @map("duration_min")
  priceCents          Int     @map("price_cents")
  appliedRules        Json    @default("[]") @map("applied_rules")
  position            Int     @default(0)

  booking             Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service             Service @relation(fields: [serviceId], references: [id])
  staff               Staff?  @relation(fields: [staffId], references: [id])

  @@map("booking_item")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @unique @map("booking_id") @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  rating    Int      @db.SmallInt
  title     String?
  body      String?
  status    String   @default("published")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author    AppUser? @relation(fields: [authorId], references: [id])

  @@index([shopId])
  @@map("review")
}
