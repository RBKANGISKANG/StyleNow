# Migrations run as the owner; the API connects as app_api so row-level security
# is actually enforced (RLS is bypassed by table owners and superusers).
DATABASE_URL=postgresql://app_api:stylenow@localhost:5432/stylenow
MIGRATION_DATABASE_URL=postgresql://postgres:stylenow@localhost:5432/stylenow
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=stylenow-media
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
POSTMARK_SERVER_TOKEN=
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
JWT_SIGNING_KEY=
IP_HASH_SALT=
DEFAULT_LOCALE=de-DE
DEFAULT_TIMEZONE=Europe/Berlin
PLATFORM_COMMISSION_BPS=1200
HOLD_TTL_SECONDS=480
MAX_PRICE_UPLIFT_PCT=25
MAX_PRICE_DISCOUNT_PCT=60
